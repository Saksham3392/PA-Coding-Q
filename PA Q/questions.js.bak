      {
        title: "Division & Reduction",
        text: "If <code>n % d == 0</code>, print <code>d</code> and recurse on <code>(n / d, d)</code>. Otherwise, increment divisor: <code>(n, d + 1)</code>."
      }
    ],
    sampleCases: [

    solutionCode: `import java.util.*;

// Do NOT change the class name
class Node
{
  int data;
  Node next;
  Node prev;
  Node(int d)
  {
    data=d;
  }
}

class Main
{
  Node head;
  // Insert in end
  Node insertEnd(int data)
  {
    Node newLink = new Node(data);
    Node last = head;
    newLink.next = null;   // link new node to NULL as it is last node
    if (head == null)  // if list is empty add in beginning.
    {
      head = newLink;
      newLink.prev = null;
      return head;
    }
    while (last.next != null)  // Find the last node
      last = last.next;
    last.next = newLink;  // Add the node after the last node of list
    newLink.prev = last;
    return head;
  }

  void traverse(Node head)
  {
    while (head != null)
    {
      System.out.print(head.data + " ");
      head = head.next;
    }
  }
/* 
 *  class Node {
 *    int data;
 *    Node next;
 *    Node prev;
 *  };
 *
 *  The above class defines the linked list node.
 */

// Return the head of updated list after swapping the two nodes
Node swapNodes(Node head, int x, int y) {
  if (head == null || x == y) return head;
  Node nodeX = null, nodeY = null;
  Node curr = head;
  while (curr != null) {
    if (curr.data == x) nodeX = curr;
    if (curr.data == y) nodeY = curr;
    curr = curr.next;
  }
  if (nodeX != null && nodeY != null) {
    int temp = nodeX.data;
    nodeX.data = nodeY.data;
    nodeY.data = temp;
  }
  return head;
}
public static void main(String[] args)
  {
    int t,n,m,x,y;
    Scanner s = new Scanner(System.in);
    t=Integer.parseInt(s.nextLine());
    while(t>0)
    {
      Main o1 = new Main();
      Node head = null;
      n = s.nextInt();
      while(n>0)
      {
        m = s.nextInt();
        head = o1.insertEnd(m);
        n--;
      }
      x = s.nextInt();
      y = s.nextInt();
      head = o1.swapNodes(head, x, y);
      o1.traverse(head);
      System.out.println();
      t--;
    }
  }
}`,

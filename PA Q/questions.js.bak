    System.out.printf("%.1f", p);
  }
}`,
    solution: `import java.util.*;
class Result
{
  static class Item implements Comparable<Item> {
    int val, weight;
    double ratio;
    Item(int val, int weight) {
      this.val = val;
      this.weight = weight;
      this.ratio = (double) val / weight;
    }
    public int compareTo(Item other) {
      return Double.compare(other.ratio, this.ratio); // descending density
    }
  }

  static double fractionalKnapsack(int val[], int weight[], int n, int capacity)
  {
    Item[] items = new Item[n];
    for (int i = 0; i < n; i++) {
      items[i] = new Item(val[i], weight[i]);
    }
    Arrays.sort(items);

    double totalVal = 0.0;
    int curWeight = 0;

    for (int i = 0; i < n; i++) {
      if (curWeight + items[i].weight <= capacity) {
        curWeight += items[i].weight;
        totalVal += items[i].val;
      } else {
        int remain = capacity - curWeight;
        totalVal += items[i].ratio * remain;
        break;
      }
    }
    return totalVal;
  }
}
class Main
{
  public static void main(String[] args)
  {
    double p;
    String sp;
    int i, n, k, cap;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    n = Integer.parseInt(s.nextLine().trim());
    int a[]=new int[n];
    int b[]=new int[n];
    for(i=0;i<n;i++)
      a[i] = s.nextInt();
    sp = (s.nextLine().trim());
    for(i=0;i<n;i++)
      b[i] = s.nextInt();
    sp = (s.nextLine().trim());
    cap = s.nextInt();
    p = Result.fractionalKnapsack(a,b,n,cap);
    System.out.printf("%.1f", p);
  }
}`,
    hints: [
      {
        title: "Greedy Choice Property",
        text: "Calculate the value-to-weight ratio <code>(double)val[i] / weight[i]</code> for each item. Sort items descending by this ratio."
      },
      {
        title: "Fill Capacity",
        text: "Take whole items while possible. When the remaining capacity is less than the current item's weight, take the fractional part <code>ratio * remainingCapacity</code> and stop."
      }
    ],
    sampleCases: [
      {
        id: 1,
        input: "3\n25 24 15\n18 15 10\n20",
        expected: "31.5",
        explanation: "Pick 2nd item in full (wt 15, val 24) and 3rd item half (wt 5, val 7.5), total weight = 20, profit = 31.5."
      }
    ],

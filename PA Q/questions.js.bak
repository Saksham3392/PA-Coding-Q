    int a[]=new int[n];
    for(i=0;i<n;i++)
      a[i] = s.nextInt();
    sp = (s.nextLine().trim());
    sum = Integer.parseInt(s.nextLine().trim());
    Result.findTheSubArray(a,n,sum);
  }
}`,

class Main
{
  public static void main(String[] args)
  {
    int i,T, n, k;
    Scanner s1=new Scanner(System.in);
    if (!s1.hasNextLine()) return;
    T=Integer.parseInt(s1.nextLine().trim());
    while(T > 0)
    {
      T--;
      n = s1.nextInt();
      k = s1.nextInt();
      int a[] = new int[n];
      for(i=0;i<n;i++)
        a[i] = s1.nextInt();
      System.out.println(Result.getPairsCount(a, n, k));
    }
  }
}`,
    solution: `import java.util.*;
class Result {
  static int getPairsCount(int arr[], int n, int k) {
    HashSet<Integer> set = new HashSet<>();
    for (int x : arr) set.add(x);
    int count = 0;
    for (int x : arr) {
      if (set.contains(x + k)) {
        count++;
      }
    }
    return count;
  }
}
class Main
{
  public static void main(String[] args)
  {
    int i,T, n, k;
    Scanner s1=new Scanner(System.in);
    if (!s1.hasNextLine()) return;
    T=Integer.parseInt(s1.nextLine().trim());
    while(T > 0)
    {
      T--;
      n = s1.nextInt();
      k = s1.nextInt();
      int a[] = new int[n];
      for(i=0;i<n;i++)
        a[i] = s1.nextInt();
      System.out.println(Result.getPairsCount(a, n, k));
    }
  }
}`,

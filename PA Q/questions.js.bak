    solutionCode: `import java.util.*;
/* 
 *  class Node {
 *    int data;
 *    Node next;
 *  };
 *
 *  The above class defines the linked list node.
 */

class Result {
  static int countNodes(Node head) {
    if (head == null) return 0;
    int count = 0;
    Node curr = head;
    do {
      count++;
      curr = curr.next;
    } while (curr != null && curr != head);
    return count;
  }
}
class Node {
  int data;
  Node next;
  Node() {}
  Node(int d) {
    data=d;
  }
}


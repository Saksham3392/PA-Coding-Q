    solutionCode: `import java.util.*;

class CQStack
{
  public int maxSize; // size of stack array
  public int[] stackArray;
  public int top; // top of stack
  int[] minArray;
  int minTop = -1;

  public CQStack(int s) // constructor
  {
    maxSize = s; // set array size
    stackArray = new int[maxSize]; // create array
    minArray = new int[maxSize];
    top = -1; // no items yet
    minTop = -1;
  }
  public boolean isEmpty() // true if stack is empty
  {
    return (top == -1);
  }
  public boolean isFull() // true if stack is full
  {
    return (top == maxSize-1);
  }
/* 
int stackArray[maxSize], top = -1,maxSize;
int isFull();
int isEmpty();

Above variables are used for Stack, maxSize and top. Also above two functions are provided. */

public void push(int j) // put item on top of stack
{
  if (isFull()) return;
  stackArray[++top] = j;
  if (minTop == -1 || j <= minArray[minTop]) {
    minArray[++minTop] = j;
  }
}

public int pop() // take item from top of stack
{
  if (isEmpty()) return -1;
  int temp = stackArray[top--];
  if (minTop >= 0 && temp == minArray[minTop]) {
    minTop--;
  }
  return temp;
}

public int getMin()
{
  if (isEmpty() || minTop == -1) return -1;
  return minArray[minTop];
}
}

class Main
{
  public static void main(String[] args)
  {
    CQStack theStack = new CQStack(100); // make new stack
    Scanner s=new Scanner(System.in);
    if (!s.hasNextInt()) return;
    int t, n, q1, q2;
    t = s.nextInt();
    while(t>0)
    {
      n = s.nextInt();
      while(n>0)
      {
        q1 = s.nextInt();
        if(q1 == 1){
          q2 = s.nextInt();
          theStack.push(q2);
        }
        else if(q1 == 2)
          System.out.print(theStack.pop() + " ");
        else
          System.out.print(theStack.getMin() + " ");
        n--;
      }
      System.out.print("\\n");
      t--;
    }
  }
}`,
    hints: [
      {
        title: "Auxiliary Minimum Tracking",

static LinkList deleteBeg(LinkList head){
  if (head == null || head.next == head) return null;
  LinkList last = head;
  while (last.next != head) {
    last = last.next;
  }
  last.next = head.next;
  return head.next;
}

static LinkList deleteEnd(LinkList head){
  if (head == null || head.next == head) return null;
  LinkList curr = head;
  while (curr.next.next != head) {
    curr = curr.next;
  }
  curr.next = head;
  return head;
}

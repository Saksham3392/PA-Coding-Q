    if (!s.hasNextInt()) return;
    t=s.nextInt();
    while(t>0)
    {
      Node head = null;
      Node h2 = null;
      n=s.nextInt();
      while(n>0)
      {
        m=s.nextInt();
        head = insertEnd(head, m);
        n--;
      }
      h2 = copyList(head);
      if(h2!=null && h2==head) System.out.print("Don't be Smart, CodeQuotient is more than you!");

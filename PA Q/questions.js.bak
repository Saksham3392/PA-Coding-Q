      }
    ],
    sampleCases: [
      {
        id: 1,
        input: "3\n3 7\n5\n2 3 5 18 4\n5 8\n5\n2 9 4 11 6\n4 8\n5\n2 1 1 9 7",
        expected: "YES\nYES\nNO",
        explanation: "Case 1: 3 + 4 = 7 (YES). Case 2: 5 + 9 = 8 + 6 = 14 (YES). Case 3: Cannot balance with at most 2 weights (NO)."
      }
    ],

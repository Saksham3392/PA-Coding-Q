    solutionCode: `import java.util.*;
class Result
{
  static int minReversal(String expr){
    if (expr == null || expr.length() % 2 != 0) return -1;
    int open = 0, close = 0;
    for (int i = 0; i < expr.length(); i++) {
      char c = expr.charAt(i);
      if (c == '[') {
        open++;
      } else if (c == ']') {
        if (open > 0) {
          open--;
        } else {
          close++;
        }
      }
    }
    return (close + 1) / 2 + (open + 1) / 2;
  }
}
class Main
{
  public static void main(String[] args)
  {
    int t, ans;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    t = Integer.parseInt(s.nextLine().trim());
    while(t!=0)
    {
      String expr;
      expr = s.nextLine().trim();
      ans = Result.minReversal(expr);
      System.out.println(ans);
      t--;
    }
  }
}`,

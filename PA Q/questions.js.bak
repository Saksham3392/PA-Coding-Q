class Main
{
  public static void main(String[] args)
  {
    int t, n, i, k;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextInt()) return;
    t=s.nextInt();
    while(t != 0)
    {
      n=s.nextInt();
      int[] a=new int[n];
      for(i=0;i<n;i++)
        a[i] = s.nextInt();
      System.out.println(Result.connectCost(a, n));
      t--;
    }
  }
}`,
    solution: `import java.util.*;
class Result
{
  static int connectCost(int lengths[], int n){
    if (n <= 1) return 0;
    PriorityQueue<Integer> pq = new PriorityQueue<>();
    for (int i = 0; i < n; i++) {
        pq.add(lengths[i]);
    }
    int totalCost = 0;
    while (pq.size() > 1) {
        int first = pq.poll();
        int second = pq.poll();
        int cost = first + second;
        totalCost += cost;
        pq.add(cost);
    }
    return totalCost;
  }
}
class Main
{
  public static void main(String[] args)
  {
    int t, n, i, k;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextInt()) return;
    t=s.nextInt();
    while(t != 0)
    {
      n=s.nextInt();
      int[] a=new int[n];
      for(i=0;i<n;i++)
        a[i] = s.nextInt();
      System.out.println(Result.connectCost(a, n));
      t--;
    }
  }
}`,

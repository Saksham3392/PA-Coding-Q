  },
  q31_solve_sudoku: {
    id: "q31_solve_sudoku",
    num: "31",
    title: "Solve Sudoku",
    tag: "Sudoku Solver",
    category: "Backtracking",
    subtitle: "9×9 Grid Constraint Backtracking Solver",
    brief: `Given a partially filled 9×9 matrix i.e. mat[9][9], your goal is to assign digits (from 1 to 9) to the empty cells so that every row, column, and sub-grid of size 3×3 contains exactly one instance of the digits from 1 to 9.

If the given sudoku is not solvable, or having wrong prefilled entries, you should return -1, otherwise on successful solution return 1.

Input Format:
9 lines contains 9 integers (0-9) separated by space as elements of the sudoku matrix. Where 0 indicates null entry and other numbers are prefilled entries.

Output Format:
Print the solved sudoku grid. If not solvable, print -1.`,
    inputFormat: "9 lines of 9 space-separated integers (0 for empty cells, 1-9 for filled cells).",
    outputFormat: "Print the solved 9×9 matrix or -1.",
    starterCode: `import java.util.Scanner;

class Result {
  static final int N = 9;
  static int solveSudoku(int mat[][])
  {
    // Write your code here
    
  }
}

class Main {
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int[][] mat = new int[9][9];
    for (int i = 0; i < 9; i++) {
      for (int j = 0; j < 9; j++) {
        if (sc.hasNextInt()) {
          mat[i][j] = sc.nextInt();
        }
      }
    }
    int res = Result.solveSudoku(mat);
    if (res == 1) {
      for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
          System.out.print(mat[i][j] + (j == 8 ? "" : " "));
        }
        System.out.println();
      }
    } else {
      System.out.println("-1");
    }
  }
}`,
    solutionCode: `import java.util.Scanner;

class Result {
  static final int N = 9;

  static boolean isSafe(int[][] mat, int row, int col, int num) {
    for (int x = 0; x < 9; x++) {
      if (mat[row][x] == num || mat[x][col] == num) {
        return false;
      }
    }
    int startRow = row - row % 3, startCol = col - col % 3;
    for (int i = 0; i < 3; i++) {
      for (int j = 0; j < 3; j++) {
        if (mat[i + startRow][j + startCol] == num) {
          return false;
        }
      }
    }
    return true;
  }

  static boolean solve(int[][] mat) {
    for (int row = 0; row < 9; row++) {
      for (int col = 0; col < 9; col++) {
        if (mat[row][col] == 0) {
          for (int num = 1; num <= 9; num++) {
            if (isSafe(mat, row, col, num)) {
              mat[row][col] = num;
              if (solve(mat)) return true;
              mat[row][col] = 0;
            }
          }
          return false;
        }
      }
    }
    return true;
  }

  static boolean isValidInitialBoard(int[][] mat) {
    for (int i = 0; i < 9; i++) {
      for (int j = 0; j < 9; j++) {
        int num = mat[i][j];
        if (num != 0) {
          mat[i][j] = 0;
          if (!isSafe(mat, i, j, num)) {
            mat[i][j] = num;
            return false;
          }
          mat[i][j] = num;
        }
      }
    }
    return true;
  }

  static int solveSudoku(int mat[][])
  {
    if (!isValidInitialBoard(mat)) return -1;
    if (solve(mat)) return 1;
    return -1;
  }
}

class Main {
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    int[][] mat = new int[9][9];
    for (int i = 0; i < 9; i++) {
      for (int j = 0; j < 9; j++) {
        if (sc.hasNextInt()) {
          mat[i][j] = sc.nextInt();
        }
      }
    }
    int res = Result.solveSudoku(mat);
    if (res == 1) {
      for (int i = 0; i < 9; i++) {
        for (int j = 0; j < 9; j++) {
          System.out.print(mat[i][j] + (j == 8 ? "" : " "));
        }
        System.out.println();
      }
    } else {
      System.out.println("-1");
    }
  }
}`,

    solution: `import java.io.*;
import java.util.*;
class Result {
  static class Interval implements Comparable<Interval> {
    int start, end;
    Interval(int start, int end) {
      this.start = start;
      this.end = end;
    }
    public int compareTo(Interval other) {
      if (this.end != other.end) {
        return Integer.compare(this.end, other.end);
      }
      return Integer.compare(this.start, other.start);
    }
  }

  static int intervalScheduling(int[] start, int[] end) {
    int n = start.length;
    if (n == 0) return 0;
    Interval[] arr = new Interval[n];
    for (int i = 0; i < n; i++) {
      arr[i] = new Interval(start[i], end[i]);
    }
    Arrays.sort(arr);

    int count = 1;
    int lastEnd = arr[0].end;
    for (int i = 1; i < n; i++) {
      if (arr[i].start >= lastEnd) {
        count++;
        lastEnd = arr[i].end;
      }
    }
    return count;
  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;

    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();
    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    System.out.print(Result.intervalScheduling(nums, maxes));
    scanner.close();
  }
}`,
    hints: [
      {
        title: "Earliest Finish Time Strategy",
        text: "Sort the intervals by finish time ascending. Always select the interval that ends earliest to leave maximum room for remaining intervals."
      }
    ],
    sampleCases: [
      {
        id: 1,
        input: "4\n10 25 12 40\n26 32 22 50",
        expected: "3",
        explanation: "Selected intervals: (12, 22), (25, 32), (40, 50). Total = 3 intervals."
      }
    ],
    edgeCases: [
      {
        id: 2,
        input: "6\n1 3 0 5 8 5\n2 4 6 7 9 9",
        expected: "4",
        explanation: "Compatible intervals: (1, 2), (3, 4), (5, 7), (8, 9). Total = 4."
      },
      {
        id: 3,
        input: "3\n1 2 3\n4 5 6",
        expected: "1",
        explanation: "All intervals overlap, maximum 1 can be scheduled."
      }
    ]
  },

  q119_job_scheduling_with_deadlines: {
    id: "q119_job_scheduling_with_deadlines",
    num: "119",
    title: "Job Scheduling with deadlines",
    tag: "Job Sequencing",
    category: "Greedy Algorithms",
    subtitle: "Maximize Profit Subject to Deadlines",
    brief: `Mr. Amit have some jobs to be scheduled. Each job must meet the deadline to be counted as completed i.e. scheduling a job after its deadline is of no use.

Each job has some profit associated with it. Mr. Amit wants to schedule the as much jobs as he can and also want to earn the maximum profit.

Note: Each job needs 1 time unit for execution.

Input Format:
The 1st line contains an integer N, the number of jobs.
The 2nd line contains N integers separated by space denoting deadline times of N jobs.
The 3rd line contains N integers separated by space denoting profits of N jobs.

Output Format:
Print the maximum profit that can be earned.

Constraints:
1 <= N <= 10^5
1 <= Deadline <= 100
1 <= Profit <= 500`,
    inputFormat: "First line: N. Second line: N deadlines. Third line: N profits.",
    outputFormat: "Print the maximum profit.",
    starterCode: `import java.io.*;
import java.util.*;
class Result {
  static int jobScheduling(int[] deadlines, int[] profits) {
    // Write your code here


  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;

    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();
    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    System.out.print(Result.jobScheduling(nums, maxes));
    scanner.close();
  }
}`,
    solution: `import java.io.*;
import java.util.*;
class Result {
  static class Job implements Comparable<Job> {
    int deadline, profit;
    Job(int deadline, int profit) {
      this.deadline = deadline;
      this.profit = profit;
    }
    public int compareTo(Job other) {
      return Integer.compare(other.profit, this.profit); // descending profit
    }
  }

  static int jobScheduling(int[] deadlines, int[] profits) {
    int n = deadlines.length;
    if (n == 0) return 0;
    Job[] jobs = new Job[n];
    int maxDeadline = 0;
    for (int i = 0; i < n; i++) {
      jobs[i] = new Job(deadlines[i], profits[i]);
      if (deadlines[i] > maxDeadline) {
        maxDeadline = deadlines[i];
      }
    }
    Arrays.sort(jobs);

    boolean[] slot = new boolean[maxDeadline + 1];
    int totalProfit = 0;

    for (int i = 0; i < n; i++) {
      for (int t = Math.min(maxDeadline, jobs[i].deadline); t >= 1; t--) {
        if (!slot[t]) {
          slot[t] = true;
          totalProfit += jobs[i].profit;
          break;
        }
      }
    }
    return totalProfit;
  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;

    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();
    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    System.out.print(Result.jobScheduling(nums, maxes));
    scanner.close();
  }
}`,
    hints: [
      {
        title: "Greedy Strategy by Profit",
        text: "Sort jobs descending by profit. For each job, find the latest available time slot from <code>min(maxDeadline, job.deadline)</code> down to 1."
      }
    ],
    sampleCases: [
      {
        id: 1,
        input: "4\n2 1 1 2\n6 8 5 10",
        expected: "18",
        explanation: "Job with profit 8 at slot 1, job with profit 10 at slot 2. Total profit = 18."
      }
    ],
    edgeCases: [
      {
        id: 2,
        input: "5\n2 1 2 1 3\n100 19 27 25 15",
        expected: "142",
        explanation: "Slots filled: slot 2: job profit 100, slot 1: job profit 27, slot 3: job profit 15. Total = 100 + 27 + 15 = 142."
      },
      {
        id: 3,
        input: "3\n1 1 1\n20 10 40",
        expected: "40",
        explanation: "Only 1 slot at time 1 available, pick job with max profit 40."
      }
    ]
  },

  q120_activity_selection_problem: {
    id: "q120_activity_selection_problem",
    num: "120",
    title: "Activity Selection Problem",
    tag: "Activity Selection",
    category: "Greedy Algorithms",
    subtitle: "Select and Output Start Times of Maximum Activities",
    brief: `Activity is defined as a interval of time for its execution. Every activity has a start time and a finish time. You are given N activities with their start and finish times.

Select the maximum number of activities that can be performed by a single person, assuming that a person can only work on a single activity at a time.

Note: Remember that you should take care of overlapping of activity times, and always choose the very next activity instead of jump if that does not make any difference to the maximum number of activities.

Input Format:
The 1st line contains an integer N, the number of activities.
The 2nd line contains N integers separated by space denoting starting times of N activities.
The 3rd line contains N integers separated by space denoting finishing times of N activities.

Output Format:
Print the starting time of picked activities in sorted order separated by space.

Constraints:
1 <= N <= 10^5`,
    inputFormat: "First line: N. Second line: N start times. Third line: N finish times.",
    outputFormat: "Print the start times of chosen activities in ascending sorted order separated by space.",
    starterCode: `import java.io.*;
import java.util.*;
class Result {
  // Print the starting time of selected activities in sorted order separated by space
  static void activitySelection(int[] start, int[] finish) {
    // Write your code here


  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;

    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();
    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    Result.activitySelection(nums, maxes);
    scanner.close();
  }
}`,
    solution: `import java.io.*;
import java.util.*;
class Result {
  static class Activity implements Comparable<Activity> {
    int start, finish, origIdx;
    Activity(int start, int finish, int origIdx) {
      this.start = start;
      this.finish = finish;
      this.origIdx = origIdx;
    }
    public int compareTo(Activity other) {
      if (this.finish != other.finish) {
        return Integer.compare(this.finish, other.finish);
      }
      return Integer.compare(this.start, other.start);
    }
  }

  // Print the starting time of selected activities in sorted order separated by space
  static void activitySelection(int[] start, int[] finish) {
    int n = start.length;
    if (n == 0) return;
    Activity[] acts = new Activity[n];
    for (int i = 0; i < n; i++) {
      acts[i] = new Activity(start[i], finish[i], i);
    }
    Arrays.sort(acts);

    List<Integer> selectedStarts = new ArrayList<>();
    selectedStarts.add(acts[0].start);
    int lastFinish = acts[0].finish;

    for (int i = 1; i < n; i++) {
      if (acts[i].start >= lastFinish) {
        selectedStarts.add(acts[i].start);
        lastFinish = acts[i].finish;
      }
    }

    Collections.sort(selectedStarts);
    StringBuilder sb = new StringBuilder();
    for (int i = 0; i < selectedStarts.size(); i++) {
      if (i > 0) sb.append(" ");
      sb.append(selectedStarts.get(i));
    }
    System.out.print(sb.toString());
  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;

    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();
    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    Result.activitySelection(nums, maxes);
    scanner.close();
  }
}`,
    hints: [
      {
        title: "Sort by Finish Time",
        text: "Sort activities by finish time ascending. Select the first activity, then pick each subsequent activity whose start time is >= the finish time of the last selected activity."
      },
      {
        title: "Output Order",
        text: "Collect the start times of the chosen activities, sort them in ascending order, and print them separated by space."
      }
    ],
    sampleCases: [
      {
        id: 1,
        input: "3\n20 22 30\n30 35 40",
        expected: "20 30",
        explanation: "Activities (20, 30) and (30, 40) are chosen. Their start times 20 and 30 are printed."
      }
    ],
    edgeCases: [
      {
        id: 2,
        input: "6\n1 3 0 5 8 5\n2 4 6 7 9 9",
        expected: "1 3 5 8",
        explanation: "Activities chosen: (1, 2), (3, 4), (5, 7), (8, 9). Start times printed in sorted order: 1 3 5 8."
      },
      {
        id: 3,
        input: "4\n10 12 20 35\n20 25 30 40",
        expected: "10 20 35",
        explanation: "Activities chosen: (10, 20), (20, 30), (35, 40). Start times: 10 20 35."
      }
    ]
  }

};

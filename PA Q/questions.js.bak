  public static void main(String[] args)
  {
    String str;
    Result o1 = new Result();
    Scanner sc = new Scanner(System.in);
    if (!sc.hasNext()) return;
    str = sc.next();
    System.out.println(o1.firstUniqueChar(str));
  }
}`,

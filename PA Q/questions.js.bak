    solutionCode: `import java.util.*;

class Result {
  static int checkPalindrome(Node head) {
    if (head == null) return 0;
    ArrayList<Integer> list = new ArrayList<>();
    Node curr = head;
    while (curr != null) {
      list.add(curr.data);
      curr = curr.next;
    }
    int l = 0, r = list.size() - 1;
    while (l < r) {
      if (!list.get(l).equals(list.get(r))) {
        return 0;
      }
      l++;
      r--;
    }
    return 1;
  }
}
class Node {

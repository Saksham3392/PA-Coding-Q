    solutionCode: `import java.util.Scanner;

class Node
{
  int data;
  Node next;
  Node(int d)
  {
    data=d;
  }
}

class Main
{
  static Node insertEnd(Node head, int data)
  {
    Node newLink = new Node(data);
    Node last = head;
    newLink.next = null;
    if (head == null)
    {
      head = newLink;
      return head;
    }
    while (last.next != null)
      last = last.next;
    last.next = newLink;
    return head;
  }

  static void forwardPrint(Node head)
  {
    Node current = head;
    while(current != null)
    {
      System.out.print(current.data + " ");
      current = current.next;
    }
  }

  static Node shiftSmallLarge(Node head) {
    if (head == null || head.next == null) return head;

    int minVal = head.data;
    int maxVal = head.data;
    Node curr = head;
    while (curr != null) {
      if (curr.data < minVal) minVal = curr.data;
      if (curr.data > maxVal) maxVal = curr.data;
      curr = curr.next;
    }

    if (minVal == maxVal) return head;

    // 1. Move min to front
    if (head.data != minVal) {
      Node prev = head;
      while (prev.next != null && prev.next.data != minVal) {
        prev = prev.next;
      }
      if (prev.next != null) {
        Node minNode = prev.next;
        prev.next = minNode.next;
        minNode.next = head;
        head = minNode;
      }
    }

    // 2. Move max to end
    Node tail = head;
    while (tail.next != null) {
      tail = tail.next;
    }

    if (tail.data != maxVal) {
      Node maxNode = null;
      if (head.data == maxVal) {
        maxNode = head;
        head = head.next;
      } else {
        Node prev = head;
        while (prev.next != null && prev.next.data != maxVal) {
          prev = prev.next;
        }
        if (prev.next != null) {
          maxNode = prev.next;
          prev.next = maxNode.next;
        }
      }
      if (maxNode != null) {
        maxNode.next = null;
        tail.next = maxNode;
      }
    }

    return head;
  }

  public static void main(String[] args)
  {
    int t,n,m;
    Scanner s = new Scanner(System.in);
    if (!s.hasNextInt()) return;
    t=s.nextInt();
    while(t>0)
    {
      Node head = null;
      n=s.nextInt();
      while(n>0)
      {
        m=s.nextInt();
        head = insertEnd(head, m);
        n--;
      }
      head = shiftSmallLarge(head);
      forwardPrint(head);
      System.out.print("\n");
      t--;
    }
  }
}`,

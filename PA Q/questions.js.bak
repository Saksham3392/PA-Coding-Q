class Main
{
  public static void main(String[] args)
  {
    int a[][]=new int[1000][1000];
    int i, j, m, n;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextInt()) return;
    m = s.nextInt();
    n = Integer.parseInt(s.nextLine().trim());
    for(i=0;i<m;i++)
      for(j=0;j<n;j++)
        a[i][j] = s.nextInt();
    System.out.println(Result.minCostPath(a,m,n));
  }
}`,
    solution: `import java.util.Scanner;
import java.util.*;
class Result
{
  static int minCostPath(int cost[][], int m, int n){
    int[][] dp = new int[m][n];
    dp[0][0] = cost[0][0];
    for (int j = 1; j < n; j++) dp[0][j] = dp[0][j - 1] + cost[0][j];
    for (int i = 1; i < m; i++) dp[i][0] = dp[i - 1][0] + cost[i][0];

    for (int i = 1; i < m; i++) {
      for (int j = 1; j < n; j++) {
        dp[i][j] = cost[i][j] + Math.min(dp[i - 1][j - 1], Math.min(dp[i - 1][j], dp[i][j - 1]));
      }
    }
    return dp[m - 1][n - 1];
  }
}
class Main
{
  public static void main(String[] args)
  {
    int a[][]=new int[1000][1000];
    int i, j, m, n;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextInt()) return;
    m = s.nextInt();
    n = Integer.parseInt(s.nextLine().trim());
    for(i=0;i<m;i++)
      for(j=0;j<n;j++)
        a[i][j] = s.nextInt();
    System.out.println(Result.minCostPath(a,m,n));
  }
}`,

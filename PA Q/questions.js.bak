    solutionCode: `import java.util.*;

// Do NOT change the class name
class Node
{
  int data;
  Node next;
  Node prev;
  Node(int d)
  {
    data=d;
  }
}

class Main
{
  // Insert in end
  static Node insertEnd(Node head, int data)
  {
    Node newLink = new Node(data);
    Node last = head;
    newLink.next = null;   // link new node to NULL as it is last node
    if (head == null)  // if list is empty add in beginning.
    {
      head = newLink;
      newLink.prev = null;
      return head;
    }
    while (last.next != null)  // Find the last node
      last = last.next;
    last.next = newLink;  // Add the node after the last node of list
    newLink.prev = last;
    return head;
  }

  static void traverse(Node first)
  {
    while (first != null)
    {
      System.out.print(first.data + " ");
      first = first.next;
    }
  }
  /* 
   *  class Node {
   *    int data;
   *    Node next;
   *    Node prev;
   *  };
   *
   *  The above class defines the linked list node.
   */

  static Node rearrangeList(Node head) {
    if (head == null || head.next == null) return head;
    Node oddHead = null, oddTail = null;
    Node evenHead = null, evenTail = null;
    Node curr = head;
    int pos = 1;
    while (curr != null) {
      Node next = curr.next;
      curr.next = null;
      curr.prev = null;
      if (pos % 2 == 0) {
        if (evenHead == null) {
          evenHead = curr;
          evenTail = curr;
        } else {
          evenTail.next = curr;
          curr.prev = evenTail;
          evenTail = curr;
        }
      } else {
        if (oddHead == null) {
          oddHead = curr;
          oddTail = curr;
        } else {
          oddTail.next = curr;
          curr.prev = oddTail;
          oddTail = curr;
        }
      }
      curr = next;
      pos++;
    }
    if (evenHead == null) return oddHead;
    evenTail.next = oddHead;
    if (oddHead != null) {
      oddHead.prev = evenTail;
    }
    return evenHead;
  }
public static void main(String[] args)
  {
    int t,n,m,x,y;
    Scanner s = new Scanner(System.in);
    t=Integer.parseInt(s.nextLine().trim());
    while(t>0)
    {
      Node head = null, t1, t2;
      n=s.nextInt();
      while(n>0)
      {
        m=s.nextInt();
        head = insertEnd(head, m);
        n--;
      }
      t1 = rearrangeList(head);
      traverse(t1);
      System.out.println();
      t--;
    }
  }
}`,

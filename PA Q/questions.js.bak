1 <= n <= 10^5`,
    inputFormat: "First line: T. For each testcase: first line is N, second line has N space-separated integers.",
    outputFormat: "For each testcase, print the max-heap array elements separated by space.",
    starterCode: `import java.util.Scanner;

class Main
{
static void modifyMintoMax(int array[], int n)
{

}
public static void main(String[] args)
 {
  int t, n, i, k;
  Scanner s=new Scanner(System.in);
  if (!s.hasNextInt()) return;
  t=s.nextInt();
  while(t != 0)
  {
    n=s.nextInt();
    int[] a=new int[n];
    for(i=0;i<n;i++)
      a[i] = s.nextInt();
    modifyMintoMax(a,n);

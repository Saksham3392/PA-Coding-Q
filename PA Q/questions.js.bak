    solutionCode: `import java.util.*;
class Node
{
  int data; // data used as key value
  Node left;
  Node right;
  public Node()
  {
    data=0;
  }
  public Node(int d)
  {
    data=d;
  }
}

class Main
{
  static void preOrder(Node root)
  {
    if (root != null)
    {
      System.out.print(root.data + " ");
      preOrder(root.left);
      preOrder(root.right);
    }
  }

  static Node buildTree(int arr[], int n)
  {
    if (n <= 0 || arr[0] == -1) return null;
    Node root = new Node(arr[0]);
    Queue<Node> q = new LinkedList<Node>();
    q.add(root);
    
    int i = 1;
    while (i < n && q.size() > 0)
    {
      Node parent = q.peek();
      q.remove();

      // If left child exists
      if (arr[i] != -1)
      {
        parent.left = new Node(arr[i]);
        q.add(parent.left);
      }
      i++;

      // If right child exists
      if (i < n && arr[i] != -1)
      {
        parent.right = new Node(arr[i]);
        q.add(parent.right);
      }
      i++;
    }
    return root;
  }

  static int totalPaths = 0;

  static void findPaths(Node root, List<Integer> path) {
    if (root == null) return;
    path.add(root.data);
    if (root.left == null && root.right == null) {
      totalPaths++;
      for (int val : path) {
        System.out.print(val + " ");
      }
      System.out.println(path.size() - 1);
    } else {
      findPaths(root.left, path);
      findPaths(root.right, path);
    }
    path.remove(path.size() - 1);
  }

  static void printAllPaths(Node root) {
    if (root == null) return;
    totalPaths = 0;
    findPaths(root, new ArrayList<>());
    System.out.println(totalPaths);
  }

  public static void main(String[] args)
  {
    int n, i;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    n = Integer.parseInt(s.nextLine().trim());
    int a[]=new int[n];
    for(i=0;i<n;i++)
      a[i] = s.nextInt();
    Node root = null;
    if(n!=0)
      root = buildTree(a, n);
    printAllPaths(root);
  }
}`,

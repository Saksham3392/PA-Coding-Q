    solution: `import java.util.*;
class Result
{
  static int zeroOneKnapsack(int val[], int weight[], int n, int capacity){
    int[] dp = new int[capacity + 1];
    for (int i = 0; i < n; i++) {
      for (int w = capacity; w >= weight[i]; w--) {
        dp[w] = Math.max(dp[w], dp[w - weight[i]] + val[i]);
      }
    }
    return dp[capacity];
  }
}

    solutionCode: `import java.util.*;
class Node
{
  int data; // data used as key value
  Node left;
  Node right;
  public Node()
  {
    data=0;
  }
  public Node(int d)
  {
    data=d;
  }
}

class Main
{
  static void inOrder(Node root)
  {
    if (root != null)
    {
      inOrder(root.left);
      System.out.print(root.data + " ");
      inOrder(root.right);
    }
  }

  static Node insertLevelOrder(int[] arr, int i, int n) {
    if (i < n) {
      Node temp = new Node(arr[i]);
      temp.left = insertLevelOrder(arr, 2 * i + 1, n);
      temp.right = insertLevelOrder(arr, 2 * i + 2, n);
      return temp;
    }
    return null;
  }

  static Node buildTree(int arr[], int n) {
    if (n <= 0) return null;
    return insertLevelOrder(arr, 0, n);
  }

  public static void main(String[] args)
  {
    int n, i;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    n = Integer.parseInt(s.nextLine().trim());
    int a[]=new int[n];
    for(i=0;i<n;i++)
      a[i] = Integer.parseInt(s.nextLine().trim());
    Node root = null;
    root = buildTree(a, n);
    inOrder(root);
  }
}`,

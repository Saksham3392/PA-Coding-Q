    solution: `import java.util.*;
class Result
{
  static int largSubArray(int ar[], int n){
    Map<Long, Integer> map = new HashMap<>();
    map.put(0L, -1);
    int maxLen = -1;
    long currSum = 0;
    for (int i = 0; i < n; i++) {
      currSum += ar[i];
      if (map.containsKey(currSum)) {
        maxLen = Math.max(maxLen, i - map.get(currSum));
      } else {
        map.put(currSum, i);
      }
    }
    return maxLen;
  }
}
class Main
{
  public static void main(String[] args)
  {
    int a[]=new int[50];
    int p;

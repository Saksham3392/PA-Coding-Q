    solution: `import java.io.*;
import java.math.*;
import java.security.*;
import java.text.*;
import java.util.*;
import java.util.concurrent.*;
import java.util.regex.*;
class Result {
  static int arraysEqualorNot(int[] A, int[] B) {
    if (A.length != B.length) return 0;
    Map<Integer, Integer> map = new HashMap<>();
    for (int x : A) map.put(x, map.getOrDefault(x, 0) + 1);
    for (int x : B) {
      if (!map.containsKey(x)) return 0;
      int count = map.get(x);
      if (count == 1) map.remove(x);
      else map.put(x, count - 1);
    }
    return map.isEmpty() ? 1 : 0;
  }
}
class Main {
  public static void main(String[] args) throws IOException {
    Scanner scanner = new Scanner(System.in);
    String sp;
    if (!scanner.hasNextLine()) return;
    int numsCount = Integer.parseInt(scanner.nextLine().trim());
    int[] nums = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      nums[i] = scanner.nextInt();
    sp = scanner.nextLine().trim();

    int[] maxes = new int[numsCount];
    for (int i = 0; i < numsCount; i++)
      maxes[i] = scanner.nextInt();

    int res = Result.arraysEqualorNot(nums, maxes);
      System.out.println(res);
    scanner.close();
  }
}`,

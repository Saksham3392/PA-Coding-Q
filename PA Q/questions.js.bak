    solutionCode: `import java.util.*;

class Node
{
  int data;
  Node next;
  Node(int d)
  {
    data=d;
  }
}

class Result {
  static int loopInList(Node head) {
    if (head == null || head.next == null) return 0;
    Node slow = head;
    Node fast = head;
    boolean hasCycle = false;
    while (fast != null && fast.next != null) {
      slow = slow.next;
      fast = fast.next.next;
      if (slow == fast) {
        hasCycle = true;
        break;
      }
    }
    if (!hasCycle) return 0;
    int count = 1;
    Node temp = slow.next;
    while (temp != slow) {
      count++;
      temp = temp.next;
    }
    return count;
  }
}

class Main
{
  static Node _last = null;
  static Node insertEnd(Node head, int data)
  {
    Node newLink = new Node(data);
    newLink.next = null;
    if (head == null)
    {
      head = newLink;
      _last = head;
      return head;
    }
    _last.next = newLink;
    _last = newLink;
    return head;
  }

  public static void main(String[] args)
  {
    int t,n,m;
    Scanner s = new Scanner(System.in);
    if (!s.hasNextInt()) return;
    t=s.nextInt();
    while(t>0)
    {
      _last = null;
      Node head = null;
      int x, ans;
      n = s.nextInt();
      while(n>0)
      {
        m = s.nextInt();
        head = insertEnd(head, m);
        n--;
      }
      x = s.nextInt();
      if (x == -1 && _last != null)
        _last.next = null;
      else if (head != null) {
        Node curr = head;
        while (curr != null && x-- > 0)
          curr = curr.next;
        _last.next = curr;
      }
      ans = Result.loopInList(head);
      System.out.println(ans);
      t--;
    }
  }
}`,

    ]
  },
  q30_solve_n_queen_problem: {
    id: "q30_solve_n_queen_problem",
    num: "30",
    title: "Solve N Queen problem",
    tag: "Classic N-Queens",
    category: "Backtracking",
    subtitle: "Non-Attacking Queen Placement on N×N Chessboard",
    brief: `The N Queen problem is the problem of placing N chess queens on an N×N chessboard so that no two queens attack each other.

You must know that a queen in chess can attack in all 8 directions.

Given the size of board as N*N, you need to count how many ways are there to place N queens on the board and save all such solutions in the given array.

Input Format:
First line contains an integer denoting the number of queens N.

Output Format:
Print all solutions in their column numbers for each row. If no solution exists, print -1.`,
    inputFormat: "A single integer denoting N.",
    outputFormat: "Print column indices for all rows in each solution. If impossible, print -1.",
    starterCode: `import java.util.*;

class Result 
{
// Complete this function to check placing queen at board[row][col] is safe or not by checking current row, left diagonal & right diagonal.
  int isSafe(int board[][], int row, int col, int N) 
  { 
    // Write your code here

  } 

// Complete this function to solve the problem and save the answers in sol ArrayList as required.
  boolean solveNQUtil(int board[][], int row, int N, ArrayList<ArrayList<Integer> > sol)
  { 
    // Write your code here

  } 
}

class Main {
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    if (!sc.hasNextInt()) return;
    int n = sc.nextInt();
    int[][] board = new int[n][n];
    ArrayList<ArrayList<Integer>> sol = new ArrayList<>();
    Result r = new Result();
    r.solveNQUtil(board, 0, n, sol);
    if (sol.isEmpty()) {
      System.out.println("-1");
    } else {
      for (ArrayList<Integer> s : sol) {
        for (int i = 0; i < s.size(); i++) {
          System.out.print(s.get(i) + (i == s.size() - 1 ? "" : " "));
        }
        System.out.println();
      }
    }
  }
}`,
    solutionCode: `import java.util.*;

class Result 
{
  int isSafe(int board[][], int row, int col, int N) 
  { 
    for (int i = 0; i < row; i++) {
      if (board[i][col] == 1) return 0;
    }
    for (int i = row - 1, j = col - 1; i >= 0 && j >= 0; i--, j--) {
      if (board[i][j] == 1) return 0;
    }
    for (int i = row - 1, j = col + 1; i >= 0 && j < N; i--, j++) {
      if (board[i][j] == 1) return 0;
    }
    return 1;
  } 

  boolean solveNQUtil(int board[][], int row, int N, ArrayList<ArrayList<Integer> > sol)
  { 
    if (row == N) {
      ArrayList<Integer> current = new ArrayList<>();
      for (int i = 0; i < N; i++) {
        for (int j = 0; j < N; j++) {
          if (board[i][j] == 1) {
            current.add(j);
          }
        }
      }
      sol.add(current);
      return true;
    }

    boolean res = false;
    for (int col = 0; col < N; col++) {
      if (isSafe(board, row, col, N) == 1) {
        board[row][col] = 1;
        res = solveNQUtil(board, row + 1, N, sol) || res;
        board[row][col] = 0;
      }
    }
    return res;
  } 
}

class Main {
  public static void main(String[] args) {
    Scanner sc = new Scanner(System.in);
    if (!sc.hasNextInt()) return;
    int n = sc.nextInt();
    int[][] board = new int[n][n];
    ArrayList<ArrayList<Integer>> sol = new ArrayList<>();
    Result r = new Result();
    r.solveNQUtil(board, 0, n, sol);
    if (sol.isEmpty()) {
      System.out.println("-1");
    } else {
      for (ArrayList<Integer> s : sol) {
        for (int i = 0; i < s.size(); i++) {
          System.out.print(s.get(i) + (i == s.size() - 1 ? "" : " "));
        }
        System.out.println();
      }
    }
  }
}`,

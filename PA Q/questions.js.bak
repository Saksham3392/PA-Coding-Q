class Result{
  static void printNextGreaterElement(int arr[],int n){
    // Write your code here


  }
}
class Main
{
  public static void main(String[] args)
  {
    Scanner s=new Scanner(System.in);
    Result result = new Result();
    int t = s.nextInt();
    while(t-- > 0){
      int n;
      n = s.nextInt();
      int arr[] = new int[n];
      int i=0;
      for(i=0;i<n;i++)
        arr[i] = s.nextInt();
      result.printNextGreaterElement(arr,n);
      System.out.println();
    }
  }

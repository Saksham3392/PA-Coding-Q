    solution: `import java.util.*;
// Other imports go here// Do NOT change the class name
class Main
{
static void printKLargest(int array[], int n, int k){
    Arrays.sort(array);
    for (int i = 0; i < k; i++) {
        System.out.print(array[n - 1 - i]);
        if (i < k - 1) System.out.print(" ");
    }
}

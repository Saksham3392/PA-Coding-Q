    solutionCode: `import java.util.Scanner;
/* class LinkList {
  int data;
  LinkList next;
  LinkList() {}
  LinkList(int d) {
    data=d;
  }
} */
class Result {
  static LinkList listCut(LinkList head) {
    if (head == null || head.next == head) return null;
    LinkList slow = head;
    LinkList fast = head;
    while (fast.next != head && fast.next.next != head) {
      slow = slow.next;
      fast = fast.next.next;
    }
    if (fast.next.next == head) {
      fast = fast.next;
    }
    LinkList head2 = slow.next;
    fast.next = head2;
    slow.next = head;
    return head2;
  }
}
class LinkList {
  int data;
  LinkList next;
  LinkList() {}
  LinkList(int d) {
    data=d;
  }
}


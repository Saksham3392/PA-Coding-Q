    solution: `import java.util.*;
class Result {
  // Return true if a pair with the sum k is found, else return false
  static boolean pairSum(int arr[], int n, int k) {
    int left = 0, right = n - 1;
    while (left < right) {
      long sum = (long)arr[left] + arr[right];
      if (sum == k) return true;
      if (sum < k) left++;
      else right--;
    }
    return false;
  }
}
class Main
{
  public static void main(String[] args)
  {
    String sp;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    int t = Integer.parseInt(s.nextLine().trim());
    while (t-- > 0) {
      int i,n,k;
      n = Integer.parseInt(s.nextLine().trim());
      int a[]=new int[n];
      for(i=0;i<n;i++)
        a[i] = s.nextInt();
      sp = (s.nextLine().trim());
      k = Integer.parseInt(s.nextLine().trim());
      if (Result.pairSum(a,n,k))
          System.out.println("Found");
      else
          System.out.println("Not Found");
    }
  }
}`,

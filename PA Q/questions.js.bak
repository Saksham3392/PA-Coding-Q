    solution: `import java.util.*;
class Result
{
  static int isArrayDivisibleInPairs(int a[], int n, int k){
    if (n % 2 != 0) return 0;
    int[] rem = new int[k];
    for (int i = 0; i < n; i++) {
      int r = ((a[i] % k) + k) % k;
      rem[r]++;
    }
    if (rem[0] % 2 != 0) return 0;
    for (int r = 1; r <= k / 2; r++) {
      if (2 * r == k) {
        if (rem[r] % 2 != 0) return 0;
      } else {
        if (rem[r] != rem[k - r]) return 0;
      }
    }
    return 1;
  }
}
class Main
{
  public static void main(String[] args)
  {
    int i,n,k;
    String sp;
    Scanner s=new Scanner(System.in);
    if (!s.hasNextLine()) return;
    n = Integer.parseInt(s.nextLine().trim());
    int a[]=new int[n];
    for(i=0;i<n;i++)
      a[i] = s.nextInt();
    sp = (s.nextLine().trim());
    k = Integer.parseInt(s.nextLine().trim());
    System.out.print(Result.isArrayDivisibleInPairs(a,n,k));
  }
}`,
